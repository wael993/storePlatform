# Local dev / seed scripts — copy to .env: cp .env.example .env

# Local dev — copy: cp .env.example .env (Atlas URI for npm run dev; use ci overlay for local Mongo on :27018)
BUSINESS_PLATFORM_MONGO_DB_CONNECTION_STRING=mongodb+srv://user:pass@cluster.example.mongodb.net
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Optional
PORT=3001
NODE_ENV=dev
LOG_LEVEL=DEBUG
# Calendar day for day filters / Today's Actions (IANA name). Keep equal to the web's VITE_BUSINESS_TIME_ZONE.
BUSINESS_TIME_ZONE=Asia/Amman
BUSINESS_PLATFORM_MONGO_DB_DATABASE_NAME=bsp-BUSINESS-platform-store-dev
BUSINESS_PLATFORM_MONGO_DB_USERNAME=
BUSINESS_PLATFORM_MONGO_DB_PASSWORD=

# Redis (optional)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# data keys only; saves are seen through the cache:gen counter, not the expiry
REDIS_CACHE_TTL_SECONDS=3600

# Cron / AI — see full list in config.ts defaults
AI_INVOICE_PROVIDER=mock
AI_REPORT_PROVIDER=mock
AI_IMPORT_PROVIDER=mock

# Seed scripts
SUPER_ADMIN_TENANT_ID=super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Backup (feature is off without BACKUP_MASTER_KEY; generate: openssl rand -base64 32)
BACKUP_MASTER_KEY=
BACKUP_OAUTH_REDIRECT_URI=http://localhost:3001/api/data/backup/oauth/callback
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_WORKER_CONCURRENCY=2
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
