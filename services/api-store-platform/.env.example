# Local dev / seed scripts — copy to .env: cp .env.example .env

# Local dev — copy: cp .env.example .env (Atlas URI for npm run dev; use ci overlay for local Mongo on :27018)
BUSINESS_PLATFORM_MONGO_DB_CONNECTION_STRING=mongodb+srv://user:pass@cluster.example.mongodb.net
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Optional
PORT=3001
NODE_ENV=dev
LOG_LEVEL=DEBUG
BUSINESS_PLATFORM_MONGO_DB_DATABASE_NAME=bsp-BUSINESS-platform-store-dev
BUSINESS_PLATFORM_MONGO_DB_USERNAME=
BUSINESS_PLATFORM_MONGO_DB_PASSWORD=

# Redis (optional)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=60

# Cron / AI — see full list in config.ts defaults
AI_INVOICE_PROVIDER=mock
AI_REPORT_PROVIDER=mock
AI_IMPORT_PROVIDER=mock

# Seed scripts
SUPER_ADMIN_TENANT_ID=super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
