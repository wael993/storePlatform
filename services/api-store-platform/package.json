{
	"name": "admin-backend",
	"version": "1.1.0",
	"main": "index.js",
	"scripts": {
		"start": "node dist/server.js",
		"sync-domain": "node scripts/sync-store-domain.cjs",
		"prebuild": "npm run sync-domain",
		"build": "tsc -p tsconfig.build.json",
		"format": "prettier --log-level warn --config ../../.prettierrc --write src",
		"lint": "eslint src --fix",
		"fm": "npm run format && npm run lint",
		"prelint": "npm run sync-domain",
		"prelint:ci": "npm run sync-domain",
		"lint:ci": "eslint src --max-warnings 0",
		"pretypecheck": "npm run sync-domain",
		"typecheck": "tsc --noEmit -p tsconfig.build.json",
		"format:check": "prettier --check --config ../../.prettierrc src",
		"audit:ci": "npm audit --audit-level=high",
		"predev": "npm run sync-domain",
		"dev": "nodemon src/server.ts",
		"pretest": "npm run sync-domain",
		"init-collections": "ts-node src/scripts/init-collections.ts",
		"seed:users": "ts-node src/scripts/create-admin-user.ts",
		"seed:customers": "ts-node src/scripts/create-initial-customers.ts",
		"seed:suppliers": "ts-node src/scripts/create-initial-suppliers.ts",
		"seed:roles": "ts-node src/scripts/seed-roles.ts",
		"seed:master": "ts-node src/scripts/seed-master-data.ts",
		"seed:super-admin": "ts-node src/scripts/create-super-admin-user.ts",
		"seed:app-tenant": "ts-node src/scripts/seed-app-tenant.ts",
		"migrate:drop-stale-indexes": "ts-node src/scripts/drop-stale-indexes.ts",
		"cron:negative-quantity-snapshot": "ts-node src/scripts/run-negative-quantity-snapshot.ts",
		"cron:subscription-lifecycle": "ts-node src/scripts/run-subscription-lifecycle.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"vp": "npm version patch",
		"vm": "npm version minor",
		"vma": "npm version major",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"pg:etl": "ts-node src/scripts/pg-etl.ts",
		"api:diff": "ts-node src/scripts/api-diff.ts",
		"stress": "ts-node src/scripts/stress.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"description": "",
	"dependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.8",
		"@types/node": "^25.5.2",
		"@types/node-cron": "^3.0.11",
		"@types/validator": "^13.12.2",
		"bcrypt": "^5.1.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"dd-trace": "^5.37.1",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.45.4",
		"exceljs": "^4.4.0",
		"express": "^4.21.2",
		"express-rate-limit": "^8.3.2",
		"ioredis": "^5.10.1",
		"jsonwebtoken": "^9.0.2",
		"lodash": "^4.17.21",
		"mongoose": "^8.10.1",
		"node-cron": "^4.2.1",
		"pg": "^8.23.1",
		"rate-limit-redis": "^4.3.1",
		"redis": "^4.7.1",
		"typescript": "^5.7.3",
		"uuid": "^13.0.0",
		"validator": "^13.12.0",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin-js": "^2.13.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"@typescript-eslint/parser": "^8.35.0",
		"@vitest/coverage-v8": "^3.2.7",
		"drizzle-kit": "^0.31.11",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"nodemon": "^3.1.9",
		"prettier": "^3.6.2",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"vitest": "^3.2.7"
	}
}
