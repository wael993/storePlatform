# Docker Compose — copy: cp .env.example .env
# For same data as npm run dev: copy Mongo/JWT/Redis/AI from services/api-store-platform/.env

JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
BUSINESS_PLATFORM_MONGO_DB_CONNECTION_STRING=mongodb+srv://user:pass@cluster.example.mongodb.net
BUSINESS_PLATFORM_MONGO_DB_DATABASE_NAME=bsp-BUSINESS-platform-store-dev

# Auto-seed only when super-admin + app tenants missing (isolated CI Mongo)
SUPER_ADMIN_TENANT_ID=super-admin
SUPER_ADMIN_EMAIL=you@yourdomain.com
SUPER_ADMIN_PASSWORD=yourpassword1

# Optional: Redis, AI — copy from services/api-store-platform/.env
# REDIS_ENABLED=false
# AI_INVOICE_PROVIDER=mock
